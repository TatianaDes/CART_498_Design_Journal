		{"id":"e47f6d18213ff79f","fromNode":"945eb101d78e865a","fromSide":"right","toNode":"02ae3407e8e06fb4","toSide":"left","label":"Pins and their abilities\n"},
		{"id":"b2e2ad040962cbff","fromNode":"c1efc3a79f6d1eff","fromSide":"right","toNode":"e04b7051d20e03e2","toSide":"left","label":"Making sure the performer did not misclick"},
		{"id":"3bb1f5af8e61b5e9","fromNode":"2bc77045a1e575c5","fromSide":"right","toNode":"945eb101d78e865a","toSide":"left","label":"Find location and pin it"},
		{"id":"d15db509352c66e5","fromNode":"1810c0f697eaff0f","fromSide":"right","toNode":"2bc77045a1e575c5","toSide":"left","label":"Home page to map page as a performer"},
		{"id":"05afdb7c5ef2f170","fromNode":"d79d87f246949527","fromSide":"right","toNode":"2fc0b6679079511e","toSide":"left","label":"End set button once everything is done"},
		{"id":"669958e6fdbf37b7","fromNode":"e049e914d971a199","fromSide":"right","toNode":"d69da084c570b523","toSide":"left","label":"Live set countdown and underneath a live tip jar"},
		{"id":"5dbb53ecf41f7367","fromNode":"e049e914d971a199","fromSide":"top","toNode":"a1e25f993b536847","toSide":"bottom","label":"All live screens will have a WiFi icon and notification of being offline"},
		{"id":"af3e323748070816","fromNode":"d79d87f246949527","fromSide":"right","toNode":"e049e914d971a199","toSide":"top","label":"Extension of 15 minutes will show on the live countdown"},
		{"id":"bad7b89a5794fb54","fromNode":"d69da084c570b523","fromSide":"right","toNode":"d79d87f246949527","toSide":"left","label":"15 minute extension button underneath"},
		{"id":"becc2e8e895cfe51","fromNode":"1810c0f697eaff0f","fromSide":"bottom","toNode":"e219613fbd5dee56","toSide":"top","label":"Add a settings/more icon on navigation bar"},
		{"id":"56b819df058009d5","fromNode":"1810c0f697eaff0f","fromSide":"left","toNode":"0bc727896cc1ea44","toSide":"right","label":"Interface colours change based on performer or audience"},
		{"id":"226553bb2fa30892","fromNode":"1810c0f697eaff0f","fromSide":"top","toNode":"7e849ee793358ac1","toSide":"bottom","label":"Use vibrant and exciting colours for the interface"},
		{"id":"195cf1f0fe100619","fromNode":"e219613fbd5dee56","fromSide":"left","toNode":"14328aa659f94ab3","toSide":"right","label":"Add light and dark mode to interface or in settings to change colour of interface"},
		{"id":"cbbcb23ca8174395","fromNode":"e219613fbd5dee56","fromSide":"bottom","toNode":"c749708ccb4e37bb","toSide":"top","label":"Reduced graphics for icons"}
	]
}